<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Mode Surfaces & Borders -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12151C" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#1A1E28" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#222734" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#141821" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#1E2330" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#10131A" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#CC12151C" />

    <SolidColorBrush x:Key="BorderBrushLight" Color="#2B3242" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#3B4459" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#252B38" />
    <SolidColorBrush x:Key="GridHeaderBgBrush" Color="#202532" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3B1C6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A889E" />

    <!-- Accents & Buttons -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="#252B3A" />
    <SolidColorBrush x:Key="SecondaryBtnHoverBrush" Color="#31394D" />
    <SolidColorBrush x:Key="SecondaryBtnPressedBrush" Color="#3B455E" />

    <!-- Segmented Theme Switch -->
    <SolidColorBrush x:Key="SegActiveBgBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="SegActiveFgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SegInactiveBgBrush" Color="#141821" />
    <SolidColorBrush x:Key="SegInactiveHoverBrush" Color="#252B3A" />

    <!-- CheckBox -->
    <SolidColorBrush x:Key="CheckBoxBgBrush" Color="#141821" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#4B556B" />

    <!-- DataGrid Active / Selected Row Highlighting -->
    <SolidColorBrush x:Key="RowEvenBgBrush" Color="#1A1E28" />
    <SolidColorBrush x:Key="RowOddBgBrush" Color="#1F2430" />
    <SolidColorBrush x:Key="RowHoverBgBrush" Color="#273042" />
    <SolidColorBrush x:Key="RowSelectedBgBrush" Color="#113B5E" />
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="RowSelectedAccentBarBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="RowSelectedFgBrush" Color="#FFFFFF" />

    <!-- Semantic Badges -->
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#0D2E24" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#10B981" />
    <SolidColorBrush x:Key="SuccessFgBrush" Color="#6EE7B7" />

    <SolidColorBrush x:Key="WarningBgBrush" Color="#36260B" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningFgBrush" Color="#FCD34D" />

    <SolidColorBrush x:Key="DangerBgBrush" Color="#3B151B" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerFgBrush" Color="#FCA5A5" />

    <SolidColorBrush x:Key="DryRunBgBrush" Color="#0F293E" />
    <SolidColorBrush x:Key="DryRunBorderBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="DryRunFgBrush" Color="#7DD3FC" />

    <SolidColorBrush x:Key="RemnantBgBrush" Color="#1E1B4B" />
    <SolidColorBrush x:Key="RemnantBorderBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="RemnantFgBrush" Color="#A5B4FC" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#151922" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#384152" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#4E5B73" />

</ResourceDictionary>
