<Window x:Class="DriverVaultCleaner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DriverVault Cleaner"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        Width="1340"
        Height="850"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}">
        <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/app.ico"
                       Width="34"
                       Height="34"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DriverVault Cleaner"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="サードパーティ製ドライバー（oem#.inf）の一覧確認・削除前バックアップ・安全整理ツール"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Theme Segmented Selector (System / Light / Dark) -->
                    <Border Background="{DynamicResource SegInactiveBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="2"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ThemeSelector"
                                         Content="自動"
                                         IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                                         Command="{Binding SetThemeSystemCommand}"
                                         Style="{StaticResource ThemeSegmentRadioStyle}"
                                         ToolTip="Windows 11 のテーマ設定に合わせる" />
                            <RadioButton GroupName="ThemeSelector"
                                         Content="☀ ライト"
                                         IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                                         Command="{Binding SetThemeLightCommand}"
                                         Style="{StaticResource ThemeSegmentRadioStyle}"
                                         Margin="2,0" />
                            <RadioButton GroupName="ThemeSelector"
                                         Content="🌙 ダーク"
                                         IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                                         Command="{Binding SetThemeDarkCommand}"
                                         Style="{StaticResource ThemeSegmentRadioStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- UAC Privilege Badge -->
                    <Border CornerRadius="6" Padding="10,5" Margin="0,0,8,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PrivilegeBadgeText}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Content="🛡️ 管理者として再起動"
                            Command="{Binding RestartAsAdminCommand}"
                            Style="{StaticResource WarningActionButtonStyle}"
                            Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" />

                    <Button Content="🔄 一覧を再読み込み"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Safety Mode Banner -->
        <Border Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                Padding="14,9"
                Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource DryRunBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DryRunBorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SafetyBannerTitle}"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="0,0,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DryRunFgBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SafetyBannerDescription}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource DryRunBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <CheckBox Content="本番実行モード (Live)"
                              IsChecked="{Binding IsLiveMode, Mode=TwoWay}"
                              Style="{StaticResource SafetyModeToggleStyle}"
                              FontSize="12"
                              FontWeight="SemiBold"
                              ToolTip="OFF（既定）: ドライラン（安全）/ ON: 実環境へバックアップ・削除を実行" />
                </Border>
            </Grid>
        </Border>

        <!-- 3. Search & Filter Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12,9" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Padding="8,5,28,5" />
                        <TextBlock Text="🔍 公開名 / 元のINF / プロバイダー / デバイス検索..."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="10,0,28,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource ChromelessIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                ToolTip="検索をクリア">
                            <Button.Visibility>
                                <Binding Path="Text.IsEmpty" ElementName="SearchBox">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="クラス:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,6,0" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AvailableClasses}"
                              SelectedItem="{Binding SelectedClass}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Margin="0,0,14,0" />

                    <!-- Quick Filter Checkboxes -->
                    <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                        <CheckBox Content="未使用のみ表示"
                                  IsChecked="{Binding OnlyUnused}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="旧版残骸のみ表示"
                                  IsChecked="{Binding OnlyRemnants}"
                                  ToolTip="同一プロバイダー・クラス・元のINF名でより新しい版がある未使用ドライバーのみ表示"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="Microsoft 製を除外"
                                  IsChecked="{Binding ExcludeMicrosoft}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="選択中のみ表示"
                                  IsChecked="{Binding OnlyChecked}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                    </WrapPanel>

                    <Button Grid.Column="4"
                            Content="条件リセット"
                            Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,5" />
                </Grid>

                <!-- Selection Actions & Summary Row -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="{Binding SelectRemnantsButtonText}"
                                Command="{Binding SelectOldRemnantsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                ToolTip="同じプロバイダー・クラス・元のINF名で、より新しい版が別に存在する未使用の古いドライバーを一括選択します" />
                        <Button Content="☑ 表示中の未使用を一括選択"
                                Command="{Binding SelectVisibleUnusedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                ToolTip="使用中デバイスがあるドライバーは安全のため除外されます" />
                        <Button Content="☐ 選択解除"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding SummaryStatusText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Main Content (DataGrid + Inspector/Log Split) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" MinWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.15*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Driver Store DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="DriversDataGrid"
                              ItemsSource="{Binding DriversView}"
                              SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                              Style="{StaticResource ModernDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource ModernDataGridRowStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="選択" Width="58" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="公開名" SortMemberPath="OemNumber" Width="116">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="▶"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource RowSelectedAccentBarBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PublishedName}"
                                                       FontFamily="Consolas, Yu Gothic UI"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="状態" SortMemberPath="ConnectedDeviceCount" Width="108">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" BorderThickness="1" ToolTip="{Binding RemnantDetailText}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOldVersionRemnant}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RemnantBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource RemnantBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UsageBadgeText}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOldVersionRemnant}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource RemnantFgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="プロバイダー"
                                                Binding="{Binding ProviderName}"
                                                Width="165" />

                            <DataGridTextColumn Header="クラス"
                                                Binding="{Binding ClassName}"
                                                Width="125" />

                            <DataGridTextColumn Header="元の名前 (INF)"
                                                Binding="{Binding OriginalName}"
                                                Width="165" />

                            <DataGridTextColumn Header="バージョン / 日付"
                                                Binding="{Binding VersionDisplay}"
                                                Width="175" />

                            <DataGridTextColumn Header="署名者"
                                                Binding="{Binding SignerName}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading Overlay -->
                    <Border Background="{DynamicResource OverlayBackgroundBrush}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,10" />
                            <TextBlock Text="ドライバーストアをスキャン中..."
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Right Pane: Detail Inspector & Execution Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.3*" MinHeight="220" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="0.9*" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- Inspector Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="選択中ドライバー詳細"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />

                        <!-- Active Driver Indicator Banner (visually paired with highlighted DataGrid row) -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource RowSelectedBgBrush}"
                                BorderBrush="{DynamicResource RowSelectedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasSelectedDriver, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Border Width="4"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource RowSelectedAccentBarBrush}"
                                        CornerRadius="5,0,0,5" />
                                <DockPanel Margin="12,7,10,7">
                                    <TextBlock Text="▶ 表示中:"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource RowSelectedAccentBarBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SelectedDriver.PublishedName}"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               FontSize="13.5"
                                               Foreground="{DynamicResource RowSelectedFgBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SelectedDriver.ProviderName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Text="左の一覧からドライバーを選択すると、詳細メタデータと紐付くデバイスが表示されます。"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding HasNoSelectedDriver, Converter={StaticResource BoolToVis}}" />

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelectedDriver, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Border Background="{DynamicResource RemnantBgBrush}"
                                        BorderBrush="{DynamicResource RemnantBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7"
                                        Margin="0,0,0,10"
                                        Visibility="{Binding SelectedDriver.IsOldVersionRemnant, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding SelectedDriver.RemnantDetailText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource RemnantFgBrush}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="102" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="元の名前:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDriver.OriginalName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="プロバイダー:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDriver.ProviderName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="クラス:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDriver.ClassName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="クラス GUID:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDriver.ClassGuid, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11.5" Padding="0" Margin="0,2" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="バージョン:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDriver.DriverVersionRaw}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="署名者:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDriver.SignerName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="属性:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedDriver.Attributes}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="WHCP:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedDriver.WhcpVersion}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2" />
                                </Grid>

                                <Separator Margin="0,2,0,8" Background="{DynamicResource BorderBrushLight}" />

                                <TextBlock Text="紐付くデバイス一覧"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,6" />

                                <Border Background="{DynamicResource SuccessBgBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDriver.IsInUse}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="現在このドライバーに紐付くデバイスはありません（未使用）。"
                                               FontSize="12"
                                               Foreground="{DynamicResource SuccessFgBrush}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding SelectedDriver.Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushLight}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="240" />
                                                        <Border DockPanel.Dock="Right"
                                                                HorizontalAlignment="Right"
                                                                Background="{DynamicResource WarningBgBrush}"
                                                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,1">
                                                            <TextBlock Text="{Binding Status}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource WarningFgBrush}" />
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBox Text="{Binding InstanceId, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontFamily="Consolas"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             CaretBrush="{DynamicResource TextSecondaryBrush}"
                                                             Padding="0"
                                                             Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent" />

                <!-- Execution Log Card -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="診断・実行ログ"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />

                        <TextBox x:Name="LogTextBox"
                                 Grid.Row="1"
                                 Text="{Binding CombinedLogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Yu Gothic UI"
                                 FontSize="11.5"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource LogBackgroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrushLight}"
                                 BorderThickness="1"
                                 Padding="8"
                                 TextChanged="LogTextBox_TextChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 5. Bottom Action & Backup Bar -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="12,9" Margin="0,10,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox Content="削除前にバックアップを作成 (推奨)"
                                  IsChecked="{Binding EnableBackup, Mode=TwoWay}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="使用中デバイスからもアンインストールして強制削除 (/uninstall /force)"
                                  IsChecked="{Binding ForceUninstall, Mode=TwoWay}"
                                  ToolTip="注意: 使用中デバイスのドライバーも強制的に削除します"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="520" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="保存先:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding BackupRootDir, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="2"
                                Content="参照..."
                                Command="{Binding BrowseBackupFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="3"
                                Content="開く"
                                Command="{Binding OpenBackupFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4" />
                    </Grid>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding PrimaryActionButtonText}"
                        Command="{Binding ExecuteCleanupCommand}"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        Padding="16,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                    <Setter Property="Background" Value="#DC2626" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 6. Status Bar -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="1"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}">
                <Run Text="パーサー: " />
                <Run Text="{Binding LastParserFormat, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </Grid>
    </Border>
</Window>
